# Ports
KAFKA_PORT_INTERNAL=9092
KAFKA_PORT_EXTERNAL=29092
DEEPHAVEN_PORT=10000
MINIO_PORT_S3=9000
MINIO_PORT_CONSOLE=9001
ICEBERG_REST_PORT=8181

# Kafka
KAFKA_TOPIC=oms-fix-proto
KAFKA_BOOTSTRAP_INTERNAL=kafka:9092
KAFKA_BOOTSTRAP_EXTERNAL=localhost:29092

# MinIO / S3 credentials (also used by Iceberg REST + DuckDB)
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=adminadmin
MINIO_BUCKET=iceberg-warehouse

# Iceberg
ICEBERG_WAREHOUSE=s3a://iceberg-warehouse/
ICEBERG_CATALOG_URI=http://iceberg-rest:8181

# Shared compose network
COMPOSE_NETWORK=oms-net
